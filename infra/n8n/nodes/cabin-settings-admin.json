{
  "name": "Cabin Settings Admin",
  "active": false,
  "settings": {
    "timezone": "UTC"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 240]
    },
    {
      "parameters": {
        "functionCode": "return items.map(item => ({ json: { key: item.json.key || 'telemetry_interval_minutes', value: item.json.value ?? 5 } }));"
      },
      "id": "prepare",
      "name": "Prepare Key/Value",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 240]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO settings (key, value, updated_at) VALUES ('{{$json.key}}', '{{$json.value}}', NOW()) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = NOW();"
      },
      "id": "upsert-setting",
      "name": "Upsert Setting",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [740, 240],
      "credentials": {
        "postgres": "Cabin Postgres"
      }
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://hooks.slack.com/services/placeholder",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "{\n  \"text\": \"Setting {{ $json.key }} updated to {{ $json.value }}\"\n}"
      },
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1020, 240]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Prepare Key/Value",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Key/Value": {
      "main": [
        [
          {
            "node": "Upsert Setting",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert Setting": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
